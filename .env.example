# 至少配置一个机票服务商。额度与价格以各服务商当前控制台为准。
# SerpAPI: https://serpapi.com/google-flights-api
SERPAPI_KEY=
# 可选后备数据源
RAPIDAPI_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# 正式监控使用生产凭据；测试环境结果不用于历史低价或邮件。
AMADEUS_ENV=production
KIWI_API_KEY=

# 管理页面/搜索/测试邮件/备份/诊断的访问密钥，至少32字符。
# 用密码管理器生成随机值；不要使用航班API或数据库的密钥。
ADMIN_TOKEN=
# 独立的定时任务密钥，至少32字符；Vercel会自动放入Bearer请求头。
CRON_SECRET=

# Vercel必填：持久化Redis REST数据库（Upstash或兼容的Vercel集成）。
# 也支持集成提供的 KV_REST_API_URL / KV_REST_API_TOKEN。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 可选：共享数据库时给不同部署设置不同数据键。
# FLIGHT_STORAGE_KEY=track-cheap-flight:store:v1
# 本地开发未配Redis时使用 data/flights.json；可选自定义目录。
# DATA_DIR=./data

# 手动搜索默认值，也是每天定时搜索的条件。
# 网页上的修改仅用于手动搜索，不会修改定时任务。
FLY_FROM=TYO
FLY_TO=DLC
# 1–365天；在范围内抽样查询，不保证检查每个日期。
SEARCH_DAYS_AHEAD=90
# 0–90晚；最短不能大于最长。
MIN_NIGHTS=3
MAX_NIGHTS=14
ADULTS=1
# 严格航司筛选，空值=全部；多个用逗号分隔。
SELECT_AIRLINES=NH
# 只要去程、返程都直飞（默认true）；false允许转机。
NONSTOP_ONLY=true
# 价格上限（日元），空值=不限。
MAX_PRICE_JPY=

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
ALERT_PRICE_JPY=70000

# 仅用于本地常驻进程 npm run cron。下面配置为日本时间每天9点。
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Tokyo
# Vercel定时由vercel.json决定：0 0 * * *（UTC）=日本时间每天9点。
