# ========== 机票搜索配置 ==========
# Kiwi.com (Tequila) API Key - 免费申请: https://tequila.kiwi.com/portal/login
KIWI_API_KEY=your_kiwi_api_key_here

# 出发城市（东京城市代码，覆盖NRT/HND）
FLY_FROM=TYO
# 到达城市（大连）
FLY_TO=DLC
# 搜索未来多少天内的航班 (90 = 3个月)
SEARCH_DAYS_AHEAD=90
# 最短停留天数（往返）
MIN_NIGHTS=3
# 最长停留天数（往返）
MAX_NIGHTS=14
# 成人数量
ADULTS=1
# 优先航司（留空则不限，多个用逗号分隔，如: NH,JL）
SELECT_AIRLINES=NH
# 最大价格（日元，超过则不存，留空=不限制）
MAX_PRICE_JPY=

# ========== 邮件通知配置 ==========
# 是否启用邮件通知 (true/false)
EMAIL_ENABLED=false
# SMTP服务器 (QQ邮箱: smtp.qq.com, Gmail: smtp.gmail.com)
SMTP_HOST=smtp.qq.com
# SMTP端口 (465 for SSL, 587 for TLS)
SMTP_PORT=465
# SMTP是否SSL
SMTP_SECURE=true
# 发件邮箱账号
SMTP_USER=your_email@qq.com
# SMTP授权码（不是登录密码！QQ邮箱在设置->账户里生成）
SMTP_PASS=your_smtp_auth_code
# 收件邮箱（可以和发件邮箱相同）
EMAIL_TO=your_email@qq.com
# 价格低于此值时触发通知（日元）
ALERT_PRICE_JPY=70000

# ========== 定时任务配置 ==========
# Cron表达式（默认每4小时搜一次: 0 */4 * * *）
CRON_SCHEDULE=0 */4 * * *
# 时区
CRON_TIMEZONE=Asia/Tokyo
